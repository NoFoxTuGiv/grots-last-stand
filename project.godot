config_version=5

[application]

config/name="Grot's Last Stand"
config/description="A lone grot attempts to survive against wave after wave of White Scars."
config/version="0.0.0.1"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=160
window/size/viewport_height=144
window/size/resizable=false
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[global_group]

Beakies=""
Beaky_Dakka=""

[gui]

theme/custom="res://resources/gls-theme.tres"

